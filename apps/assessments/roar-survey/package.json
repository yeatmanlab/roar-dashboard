{
  "name": "@roar-platform/roar-survey",
  "version": "0.2.2",
  "main": "./lib/roar-survey.umd.js",
  "module": "./lib/roar-survey.es.js",
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "import": "./lib/roar-survey.es.js",
      "require": "./lib/roar-survey.umd.js"
    },
    "./lib/*.css": {
      "import": "./lib/*.css",
      "require": "./lib/*.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "scripts": {
    "predev": "node ../../../packages/assessment-dev-cli/src/index.mjs predev",
    "dev": "vite --mode development",
    "dev:ci": "npx vite --mode development --port 8000",
    "setup": "node ../../../packages/assessment-dev-cli/src/index.mjs setup",
    "start": "node ../../../packages/assessment-dev-cli/src/index.mjs start",
    "seed:tasks": "node ../../../packages/assessment-dev-cli/src/index.mjs seed-tasks",
    "stop": "node ../../../packages/assessment-dev-cli/src/index.mjs stop",
    "restart": "node ../../../packages/assessment-dev-cli/src/index.mjs restart",
    "rebuild": "node ../../../packages/assessment-dev-cli/src/index.mjs rebuild",
    "update": "npm --prefix ../../../ run build -- --filter=@roar-platform/api-contract --filter=@roar-platform/assessment-schema --filter=@roar-platform/scoring-tables --filter=@roar-platform/assessment-sdk",
    "build": "vite build --mode lib",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write --log-level=warn",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeatmanlab/roar-dashboard.git",
    "directory": "apps/assessments/roar-survey"
  },
  "license": "STANFORD ACADEMIC SOFTWARE LICENSE FOR ROAR™",
  "dependencies": {
    "@roar-platform/assessment-sdk": "^1.0.0",
    "regenerator-runtime": "^0.14.1",
    "survey-core": "^2.0.8",
    "survey-vue3-ui": "^2.0.8"
  },
  "devDependencies": {
    "@roar-platform/assessment-schema": "^1.0.0",
    "@roar-platform/eslint-config": "*",
    "@roar-platform/prettier-config": "*",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^13.6.4",
    "eslint": "^9.0.0",
    "eslint-plugin-cypress": "^5.1.0",
    "firebase": "^10.13.2",
    "happy-dom": "^14.12.3",
    "prettier": "^3.0.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
