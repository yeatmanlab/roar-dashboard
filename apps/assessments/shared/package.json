{
  "name": "@roar-platform/assessment-shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared helpers used across ROAR assessment standalone harnesses (serve.js).",
  "type": "module",
  "scripts": {
    "build": "echo \"assessment-shared is source-only (imported directly and bundled by consuming assessments); no build step\"",
    "format": "prettier . --write --log-level=warn",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@roar-platform/assessment-sdk": "^1.0.0",
    "http-status-codes": "^2.3.0"
  },
  "peerDependencies": {
    "@sentry/browser": ">=7",
    "@sentry/integrations": ">=7",
    "firebase": ">=10"
  },
  "devDependencies": {
    "@roar-platform/assessment-schema": "^1.0.0",
    "@roar-platform/eslint-config": "*",
    "@roar-platform/prettier-config": "*",
    "eslint": "^9.0.0",
    "firebase": "^10.13.2",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.0",
    "vitest": "^3.2.4",
    "webpack": "^5.74.0"
  }
}
