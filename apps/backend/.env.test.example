# Docker-compose defaults for running tests locally and in CI.
# Copy to .env.test (or let CI do it) — Vitest loads .env.test via loadEnv().
# For CI, the seed script and server.ts read this via DOTENV_CONFIG_PATH.

# Test database connection strings (created by docker/postgres/init-dev-databases.sh)
CORE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roar_core_test
ASSESSMENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roar_assessment_test

# OpenFGA server (default Docker Compose stack)
FGA_API_URL=http://localhost:4010

# Firebase Auth emulator
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# SCRYPT params for the bulk user-import service (POST /v1/users/import). This is the public,
# known-answer test vector from Firebase's own scrypt reference implementation
# (https://github.com/firebase/scrypt) — not a secret. Same value CI sets (ci.yml) and the unit
# tests hash inline (firebase-password-hash.test.ts). The import service hashes with these and
# passes the same params to importUsers, so the emulator round-trip is self-consistent regardless
# of the values. Real deployments inject the project's actual secrets.
FIREBASE_SCRYPT_SIGNER_KEY=jxspr8Ki0RYycVU8zykbdLGjFQ3McFUH0uiiTvC8pVMXAn210wjLNmdZJzxUECKbm0QsEmYUSDzZvpjeJ9WmXA==
FIREBASE_SCRYPT_SALT_SEPARATOR=Bw==
FIREBASE_SCRYPT_ROUNDS=8
FIREBASE_SCRYPT_MEM_COST=14

# Google Cloud Project ID (matches the Firebase emulator project)
GOOGLE_CLOUD_PROJECT=demo-roar

# Test environment
NODE_ENV=test

# CORS origins allowed by the backend in test mode
ALLOWED_ORIGINS=http://127.0.0.1:4173
